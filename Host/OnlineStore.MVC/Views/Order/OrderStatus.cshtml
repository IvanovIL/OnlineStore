@using OnlineStore.Contracts.Order

@model OrderDto

@{
    ViewBag.Title = "Ваши заказы";
}

<h2>Ваши заказы</h2>

@if (Model.orderItems.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th class="orderItem">Номер заказа</th>
                <th class="orderItem">Название</th>
                <th class="orderItem">Количество</th>
                <th class="orderItem">Цена</th>
                <th class="orderItem">Действие</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.orderItems)
            {

                <tr>
                    <td class="orderItem">@item.OrderId</td>
                    <td class="orderItem">@item.ProductName</td>
                    <td class="orderItem">@item.Quantity</td>
                    <td class="orderItem">@item.UnitPrice.ToString("C")</td>
                    <td>
                        <form asp-controller="Home" asp-action="Details" asp-route-id="@item.ProductId" method="post">
                            <button type="submit">Подробнее о заказе</button>
                        </form>
                    </td>
                </tr>

            }

        </tbody>
    </table>
    <h3>Итого: @Model.TotalAmount.ToString("C")</h3> 
}
else
{
    <p>У вас нет заказов.</p>
}