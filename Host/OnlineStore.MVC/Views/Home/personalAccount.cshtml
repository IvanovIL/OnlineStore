@using OnlineStore.Contracts.Order


@model OrderDto


@{
	ViewData["Title"] = "personal Account";
}

<div class="text-center">
	<h1 class="display-10">Добро пожаловать в личный кабинет</h1>
</div>

<div align="right">

	@if (User?.Identity?.IsAuthenticated == true)
	{
		<form asp-controller="Order" asp-action="OrderStatus" method="get" class="form-inline">
			<button type="submit" class="btn btn-info">
				История покупок
			</button>
		</form>
	}
	else
	{
		<h4>Вам нужно войти в свой аккаунт что бы увидеть исиорию заказов</h4>
	}
</div>

<div align="left">
	@if (User.IsInRole("Admin"))
	{
		<form asp-controller="admin" asp-action="adminPanel" method="get" class="form-inline">
			<button type="submit" class="btn btn-info">
				Ввойти в панель администратора
			</button>
		</form>
	}
</div>